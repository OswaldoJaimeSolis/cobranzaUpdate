<resources>

    <!--
        Con targetSdkVersion 35 Android 15 impone el modo "edge to edge": el contenido se
        dibuja debajo de la barra de estado y de la barra de navegación. Las pantallas de
        esta app tienen layouts fijos heredados y no aplican window insets, así que se
        desactiva la imposición para conservar el comportamiento visual original.

        Si en el futuro se sube a targetSdkVersion 36 este opt-out deja de tener efecto y
        habrá que aplicar insets (ViewCompat.setOnApplyWindowInsetsListener) en cada
        Activity.
    -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

</resources>
