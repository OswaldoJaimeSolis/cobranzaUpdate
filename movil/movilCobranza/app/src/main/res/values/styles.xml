<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Tema base de la app: MaterialComponents (no Material3) sin action bar; cada
        Activity coloca su propia MaterialToolbar (@layout/toolbar) y la registra con
        setSupportActionBar.
    -->
    <style name="Base.AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/primary_medium</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnBackground">@color/text</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <!-- AppCompat / framework (DatePickerDialog toma el acento del tema). -->
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorControlActivated">@color/primary_medium</item>
        <item name="colorControlNormal">@color/outline_control</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>

        <!-- Forma: 8 botones/chips, 12 tarjetas/diálogos. -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Cobranza.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Cobranza.Medium</item>

        <!-- Widgets por defecto. -->
        <item name="toolbarStyle">@style/Widget.Cobranza.Toolbar</item>
        <item name="materialButtonStyle">@style/Widget.Cobranza.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Cobranza.Button.Outlined</item>
        <item name="borderlessButtonStyle">@style/Widget.Cobranza.Button.Text</item>
        <item name="textInputStyle">@style/Widget.Cobranza.TextInputLayout</item>
        <item name="materialCardViewStyle">@style/Widget.Cobranza.Card</item>
        <item name="checkboxStyle">@style/Widget.Cobranza.CheckBox</item>
        <item name="editTextStyle">@style/Widget.Cobranza.EditText</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Cobranza.Dialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Cobranza.Dialog</item>
        <item name="snackbarTextViewStyle">@style/Widget.Cobranza.SnackbarText</item>
        <!-- Evita que el modo oscuro forzado del fabricante invierta los colores de estado. -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="AppTheme" parent="Base.AppTheme" />

    <!-- Se conserva el nombre usado en el manifest; el tema base ya no tiene action bar. -->
    <style name="AppTheme.NoActionBar" />

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.MaterialComponents.Light">
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <!-- Formas -->
    <style name="ShapeAppearance.Cobranza.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">@dimen/radius_button</item>
    </style>

    <style name="ShapeAppearance.Cobranza.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">@dimen/radius_card</item>
    </style>

    <style name="ShapeAppearance.Cobranza.Field" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">@dimen/radius_field</item>
    </style>

    <!-- Tipografía (Roboto del sistema) -->
    <style name="TextAppearance.Cobranza.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="TextAppearance.Cobranza.Secondary" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/text_secondary</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Cobranza.Label" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.Cobranza.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="TextAppearance.Cobranza.Headline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="TextAppearance.Cobranza.Amount" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">@dimen/text_amount</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="TextAppearance.Cobranza.Debt" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">@dimen/text_debt</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/status_adeudo_fg</item>
    </style>

    <style name="TextAppearance.Cobranza.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Cobranza.ButtonSecondary" parent="TextAppearance.Cobranza.Button">
        <item name="android:textSize">@dimen/text_secondary</item>
    </style>

    <style name="TextAppearance.Cobranza.Toolbar" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
    </style>

    <!-- Barra superior -->
    <style name="Widget.Cobranza.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="titleTextAppearance">@style/TextAppearance.Cobranza.Toolbar</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/primary_container</item>
        <item name="navigationIconTint">@color/white</item>
    </style>

    <!-- Botones -->
    <style name="Widget.Cobranza.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/touch_preferred</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Cobranza.Button</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:paddingStart">@dimen/space_xl</item>
        <item name="android:paddingEnd">@dimen/space_xl</item>
        <item name="backgroundTint">@color/button_primary_bg</item>
    </style>

    <!-- Acción principal de la pantalla: a lo ancho, 64dp. -->
    <style name="Widget.Cobranza.Button.Primary">
        <item name="android:minHeight">@dimen/button_primary_height</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Widget.Cobranza.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Cobranza.ButtonSecondary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/button_outlined_text</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="strokeColor">@color/button_outlined_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="iconTint">@color/button_outlined_text</item>
    </style>

    <style name="Widget.Cobranza.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Cobranza.ButtonSecondary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/primary_medium</item>
        <item name="iconTint">@color/primary_medium</item>
    </style>

    <!-- Campos de texto -->
    <style name="Widget.Cobranza.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="shapeAppearance">@style/ShapeAppearance.Cobranza.Field</item>
        <item name="boxStrokeColor">@color/field_stroke</item>
        <item name="hintTextColor">@color/primary_medium</item>
        <item name="hintTextAppearance">@style/TextAppearance.Cobranza.Label</item>
        <item name="errorTextColor">@color/error</item>
    </style>

    <style name="Widget.Cobranza.TextInputEditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/field_text</item>
        <item name="android:minHeight">@dimen/touch_preferred</item>
    </style>

    <!-- EditText sueltos (p. ej. el del diálogo de condonación). -->
    <style name="Widget.Cobranza.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/field_text</item>
        <item name="android:minHeight">@dimen/touch_min</item>
    </style>

    <!-- Tarjetas -->
    <style name="Widget.Cobranza.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">@dimen/space_lg</item>
    </style>

    <!-- Checks: cuerpo 18sp y al menos 48dp de alto. -->
    <style name="Widget.Cobranza.CheckBox" parent="Widget.MaterialComponents.CompoundButton.CheckBox">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:paddingStart">@dimen/space_sm</item>
        <item name="buttonTint">@color/check_tint</item>
    </style>

    <!-- Segmentos de estado (RadioButton sin círculo). -->
    <style name="Widget.Cobranza.Segment" parent="Widget.MaterialComponents.CompoundButton.RadioButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">@dimen/touch_preferred</item>
        <item name="android:button">@null</item>
        <item name="buttonCompat">@null</item>
        <item name="useMaterialThemeColors">false</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/space_xs</item>
        <item name="android:paddingEnd">@dimen/space_xs</item>
        <item name="android:textSize">@dimen/text_secondary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Chip de estado (listas). -->
    <style name="Widget.Cobranza.StatusChip" parent="">
        <item name="android:background">@drawable/bg_status_chip</item>
        <item name="android:paddingStart">@dimen/space_sm</item>
        <item name="android:paddingEnd">@dimen/space_sm</item>
        <item name="android:paddingTop">@dimen/space_xs</item>
        <item name="android:paddingBottom">@dimen/space_xs</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/status_ausente_fg</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Contenedor con borde para Spinner (alto mínimo 56dp). -->
    <style name="Widget.Cobranza.SpinnerBox" parent="">
        <item name="android:background">@drawable/bg_field_outlined</item>
        <item name="android:minHeight">@dimen/touch_preferred</item>
    </style>

    <style name="Widget.Cobranza.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:minHeight">@dimen/touch_preferred</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Widget.Cobranza.SnackbarText" parent="Widget.MaterialComponents.Snackbar.TextView">
        <item name="android:textSize">@dimen/text_secondary</item>
        <item name="android:maxLines">4</item>
    </style>

    <!-- Diálogos: esquinas de 12dp, botones sin mayúsculas sostenidas. -->
    <style name="ThemeOverlay.Cobranza.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Cobranza.Medium</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.Cobranza.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialog.Cobranza.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Cobranza.Button.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Cobranza.Button.Dialog</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Cobranza.Button.Dialog</item>
    </style>

    <style name="MaterialAlertDialog.Cobranza.Title" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textAppearance">@style/TextAppearance.Cobranza.Title</item>
    </style>

    <style name="MaterialAlertDialog.Cobranza.Body" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textAppearance">@style/TextAppearance.Cobranza.Body</item>
    </style>

    <style name="Widget.Cobranza.Button.Dialog" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textAppearance">@style/TextAppearance.Cobranza.ButtonSecondary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/primary_medium</item>
    </style>

</resources>
