<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".contribuyente.ContribuyenteActivity">

    <include layout="@layout/toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_margin">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/nombre">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/Widget.Cobranza.TextInputEditText"
                    android:id="@+id/etCNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textCapCharacters"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/ape_paterno">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/Widget.Cobranza.TextInputEditText"
                    android:id="@+id/etCApePaterno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textCapCharacters"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/ape_materno">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/Widget.Cobranza.TextInputEditText"
                    android:id="@+id/etCApeMaterno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textCapCharacters"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/fecha_nacimiento"
                app:startIconDrawable="@drawable/ic_calendar"
                app:startIconTint="@color/primary_medium">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/Widget.Cobranza.TextInputEditText"
                    android:id="@+id/etCFechaNacimiento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="date" />
            </com.google.android.material.textfield.TextInputLayout>

            <CheckBox
                android:id="@+id/cbSinFechaNacimiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sin_fecha_nacimiento" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/rfc">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/Widget.Cobranza.TextInputEditText"
                    android:id="@+id/etCRfc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textCapCharacters"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvTipoPlaza"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginBottom="@dimen/space_xs"
                android:text="@string/tipo_plaza"
                android:textAppearance="@style/TextAppearance.Cobranza.Label" />

            <FrameLayout
                style="@style/Widget.Cobranza.SpinnerBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Spinner
                    android:id="@+id/cbTipoPlaza"
                    style="@style/Widget.Cobranza.Spinner"
                    android:layout_gravity="center_vertical"
                    android:spinnerMode="dropdown" />
            </FrameLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/giro">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/Widget.Cobranza.TextInputEditText"
                    android:id="@+id/etGiro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textCapCharacters"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/importe"
                app:prefixText="@string/moneda">

                <com.google.android.material.textfield.TextInputEditText
                    style="@style/Widget.Cobranza.TextInputEditText"
                    android:id="@+id/etCImporte"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end|center_vertical"
                    android:inputType="numberDecimal"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btnCrear"
                style="@style/Widget.Cobranza.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/crear_contribuyente" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
