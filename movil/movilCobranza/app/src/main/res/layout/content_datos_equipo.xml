<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context=".DatosEquipoActivity"
    tools:showIn="@layout/activity_datos_equipo">

    <TextView
        android:id="@+id/tvCodigoEquipo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="130px"
        android:layout_marginLeft="20px"
        android:text="Codigo:"/>
    <EditText
        android:id="@+id/etCodigoEquipo"
        android:layout_toRightOf="@id/tvCodigoEquipo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100px"
        android:layout_marginLeft="58px"
        android:ems="8"/>

    <TextView
        android:id="@+id/tvDescripcionEquipo"
        android:layout_below="@+id/etCodigoEquipo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30px"
        android:layout_marginLeft="20px"
        android:text="Descripción:"/>
    <EditText
        android:id="@+id/etDescripcionEquipo"
        android:layout_toRightOf="@+id/tvDescripcionEquipo"
        android:layout_below="@+id/etCodigoEquipo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24px"
        android:inputType="text"

        android:ems="8"/>

    <Button
        android:id="@+id/btnGuardarEquipo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/etDescripcionEquipo"
        android:text="Guadar"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="50px"/>

</RelativeLayout>