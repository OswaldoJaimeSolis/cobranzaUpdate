<?xml version="1.0" encoding="utf-8"?>
<!-- Renglón de Spinner (vista cerrada y lista desplegable): 18sp, al menos 56dp de alto. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:gravity="center_vertical"
    android:maxLines="2"
    android:minHeight="@dimen/touch_preferred"
    android:paddingStart="@dimen/space_lg"
    android:paddingTop="@dimen/space_sm"
    android:paddingEnd="@dimen/space_lg"
    android:paddingBottom="@dimen/space_sm"
    android:textColor="@color/text"
    android:textSize="@dimen/text_body" />
