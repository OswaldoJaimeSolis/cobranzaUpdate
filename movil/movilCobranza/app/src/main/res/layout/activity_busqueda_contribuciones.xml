<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".busqueda.contribuciones.BusquedaContribuciones">

    <include layout="@layout/toolbar" />

    <!-- Filtros -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="1dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_md">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/fecha"
            app:startIconDrawable="@drawable/ic_calendar"
            app:startIconTint="@color/primary_medium">

            <!-- No enfocable: al tocarla abre el calendario sin mostrar el teclado. -->
            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.Cobranza.TextInputEditText"
                android:id="@+id/etDateCB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:inputType="date" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTipoPlazaBC"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_xs"
                    android:text="@string/tipo_plaza"
                    android:textAppearance="@style/TextAppearance.Cobranza.Label" />

                <FrameLayout
                    style="@style/Widget.Cobranza.SpinnerBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Spinner
                        android:id="@+id/cbTipoPlazasBC"
                        style="@style/Widget.Cobranza.Spinner"
                        android:layout_gravity="center_vertical"
                        android:spinnerMode="dropdown" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvEstadoBC"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_xs"
                    android:text="@string/estado"
                    android:textAppearance="@style/TextAppearance.Cobranza.Label" />

                <FrameLayout
                    style="@style/Widget.Cobranza.SpinnerBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Spinner
                        android:id="@+id/cbEstadoCB"
                        style="@style/Widget.Cobranza.Spinner"
                        android:layout_gravity="center_vertical"
                        android:spinnerMode="dropdown" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ListView
        android:id="@+id/lvContribuciones"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/surface"
        android:divider="@color/divider"
        android:dividerHeight="1dp" />

</LinearLayout>
