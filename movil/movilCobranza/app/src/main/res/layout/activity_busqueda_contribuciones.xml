<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".busqueda.contribuciones.BusquedaContribuciones">



    <TextView
        android:id="@+id/tvFechaCB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20px"
        android:layout_marginTop="20px"
        android:text="Fecha"/>

    <EditText
        android:id="@+id/etDateCB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="68px"
        android:layout_toRightOf="@+id/tvFechaCB"
        android:ems="8"
        android:inputType="date" />

    <TextView
        android:id="@+id/tvTipoPlazaBC"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20px"
        android:layout_below="@id/etDateCB"
        android:text="Tipo plaza"/>

    <Spinner
        android:id="@+id/cbTipoPlazasBC"
        
        android:layout_below="@id/etDateCB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginLeft="40dp"
        android:layout_toRightOf="@+id/tvTipoPlazaBC"></Spinner>
    <TextView
        android:id="@+id/tvEstadoBC"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/cbTipoPlazasBC"
        android:layout_marginLeft="20px"
        android:text="Estado"/>

    <Spinner
        android:id="@+id/cbEstadoCB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/cbTipoPlazasBC"
        android:layout_centerHorizontal="true"
        android:layout_marginLeft="61dp"
        android:layout_toRightOf="@+id/tvEstadoBC"></Spinner>


    <ListView
        android:id="@+id/lvContribuciones"
        android:layout_below="@+id/cbEstadoCB"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"/>



</RelativeLayout>