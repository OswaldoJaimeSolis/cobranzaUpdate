<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/AppTheme.AppBarOverlay">

        <include layout="@layout/toolbar" />

        <!-- Indicadores de actividad bajo la barra: no se enciman con el formulario.
             Alto fijo para que mostrarlos u ocultarlos no mueva el contenido. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="4dp">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/pbActualizarCatalogos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/blue_light"
                app:trackColor="@color/primary_dark" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/pbBusqueda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/primary_container"
                app:trackColor="@color/primary_dark" />
        </FrameLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <include layout="@layout/content_main" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
