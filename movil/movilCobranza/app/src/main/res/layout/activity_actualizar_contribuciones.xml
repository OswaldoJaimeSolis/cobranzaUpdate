<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".ActualizarContribucionesRemotasActivity">

    <include layout="@layout/toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_margin">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/fecha_inicial"
                app:startIconDrawable="@drawable/ic_calendar"
                app:startIconTint="@color/primary_medium">

                <!-- No enfocable: al tocarla abre el calendario sin mostrar el teclado. -->
                <com.google.android.material.textfield.TextInputEditText
                    style="@style/Widget.Cobranza.TextInputEditText"
                    android:id="@+id/etFechaInicial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="date" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvTipoPlaza"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginBottom="@dimen/space_xs"
                android:text="@string/tipo_plaza"
                android:textAppearance="@style/TextAppearance.Cobranza.Label" />

            <FrameLayout
                style="@style/Widget.Cobranza.SpinnerBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Spinner
                    android:id="@+id/cbTipoPlazaRecuperarContribuciones"
                    style="@style/Widget.Cobranza.Spinner"
                    android:layout_gravity="center_vertical"
                    android:spinnerMode="dropdown" />
            </FrameLayout>

            <Button
                android:id="@+id/btnRecuperaContribucionesRemotas"
                style="@style/Widget.Cobranza.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/recuperar_contribuciones" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
