<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context=".ActualizarContribucionesRemotasActivity">



    <TextView
        android:id="@+id/tvFechaInicial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginLeft="10px"
        android:layout_marginTop="50px"
        android:text="Fecha Inicial"

        />

    <EditText
        android:id="@+id/etFechaInicial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:layout_marginLeft="200px"
        android:layout_marginTop="50px"
        android:inputType="date" />


    <TextView
        android:id="@+id/tvTipoPlaza"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tvFechaInicial"
        android:layout_marginLeft="10px"
        android:layout_marginTop="50px"
        android:text="Tipo plaza" />

    <Spinner
        android:id="@+id/cbTipoPlazaRecuperarContribuciones"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/etFechaInicial"
        android:layout_marginLeft="200px"
        android:layout_marginTop="20px"
        android:layout_toRightOf="@id/tvTipoPlaza"
        android:ems="8" />


    <Button
        android:id="@+id/btnRecuperaContribucionesRemotas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/cbTipoPlazaRecuperarContribuciones"
        android:layout_marginTop="100px"
        android:layout_centerHorizontal="true"
        android:text="Recuperar contribuciones remotas" />




</RelativeLayout>