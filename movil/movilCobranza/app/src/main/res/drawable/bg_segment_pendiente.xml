<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#1F123E6B">
    <item>
        <selector>
            <item android:state_checked="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/status_pendiente_bg" />
                    <stroke android:width="2dp" android:color="@color/status_pendiente_border" />
                    <corners android:radius="@dimen/radius_button" />
                </shape>
            </item>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="@color/background" />
                    <stroke android:width="1dp" android:color="@color/divider" />
                    <corners android:radius="@dimen/radius_button" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/surface" />
                    <stroke android:width="1dp" android:color="@color/outline_control" />
                    <corners android:radius="@dimen/radius_button" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
